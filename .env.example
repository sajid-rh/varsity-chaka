# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL (used by docker-compose and the backend)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=varsity_chaka
MYSQL_USER=chaka_user
MYSQL_PASSWORD=change_me_user
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Backend
SECRET_KEY=generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development

# OSRM (added in the routing step)
OSRM_BASE_URL=http://127.0.0.1:5000

# Seeder (python -m app.seed). Set real values in your own .env, never here.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=change_me_Abc123
SEED_FUEL_PRICE_PER_LITRE=0.00
SEED_MAX_RATE_PER_KM=0.00
